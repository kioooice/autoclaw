    <w:p>
      <w:r>
        <w:t>• 通过cron设置定期库存检查任务</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 利用node.camera拍摄货架/库存照片进行视觉识别</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 结合skills中的数据分析技能处理库存数据</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 自动化下单流程：登录→搜索→加入购物车→结算</w:t>
      </w:r>
    </w:p>
    <w:p/>
    <w:p>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:color w:val="2980B9"/>
        </w:rPr>
        <w:t>创新点：</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 视觉识别+自动化操作结合，实现"看到即购买"</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 支持无API网站，纯浏览器自动化</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 可跨多个电商平台操作</w:t>
      </w:r>
    </w:p>
    <w:p/>
    <w:p>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:color w:val="2980B9"/>
        </w:rPr>
        <w:t>实用价值：</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 避免库存短缺影响生产/生活</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 节省人工采购时间</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 支持定期重复采购（如每周食材）</w:t>
      </w:r>
    </w:p>
    <w:p/>

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading2"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:sz w:val="28"/>
          <w:color w:val="34495E"/>
