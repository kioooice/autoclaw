      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 生成摘要报告并推送到指定频道</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 支持图片、视频等多媒体内容监控</w:t>
      </w:r>
    </w:p>
    <w:p/>
    <w:p>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:color w:val="2980B9"/>
        </w:rPr>
