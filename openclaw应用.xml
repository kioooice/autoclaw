      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr>
          <w:b/>
        </w:rPr>
        <w:t>应用场景：</w:t>
      </w:r>
      <w:r>
        <w:t>竞品监控、舆情分析、信息聚合</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:color w:val="2980B9"/>
        </w:rPr>
        <w:t>核心功能：</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>• 定时抓取指定网站/社交媒体的内容更新</w:t>
